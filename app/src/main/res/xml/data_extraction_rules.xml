<?xml version="1.0" encoding="utf-8"?>
<!-- Used on Android 12+. Keeps the YouTube API key out of backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secret_settings.preferences_pb" />
        <exclude domain="sharedpref" path="secret_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secret_settings.preferences_pb" />
        <exclude domain="sharedpref" path="secret_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
